[General]
hostname = %APPEND% api.revenuecat.com, firebaseremoteconfig.googleapis.com
[Script]
locket_remote = type=http-response, pattern=^https?:\/\/firebaseremoteconfig\.googleapis\.com\/v1\/projects\/locket-.*, script-path=https://raw.githubusercontent.com/thhhh-hieu/deocogi/refs/heads/main/abc.js, requires-body=true, max-size=524288, timeout=60

deleteHeader = type=http-request, pattern=^https:\/\/api\.revenuecat\.com\/.+\/(receipts|subscribers), script-path=https://raw.githubusercontent.com/thhhh-hieu/deocogi/refs/heads/main/xyz.js, timeout=60


revenuecat = type=http-response, pattern=^https:\/\/api\.revenuecat\.com\/.+\/(receipts$|subscribers\/[^/]+$), script-path=https://raw.githubusercontent.com/thhhh-hieu/deocogi/refs/heads/main/def.js, requires-body=true, max-size=-1, timeout=60
